# TRANSITX Frontend Environment Variables

# Backend API Base URL:
# - Leave empty or omit for local Vite development (automatically proxies /api to http://127.0.0.1:8001)
# - Leave empty or omit for Vercel Monorepo Serverless (automatically routes /api to api/index.py)
# - Set to your dedicated cloud backend URL if hosting backend on Render, Railway, or Fly.io:
#   Example: VITE_API_BASE_URL=https://transitx-backend.onrender.com
VITE_API_BASE_URL=

# Optional Mapbox Access Token for high-resolution vector satellite layers:
# (If omitted, high-resolution Esri World Street Map & Esri World Imagery layers are used automatically without any API key required)
VITE_MAPBOX_ACCESS_TOKEN=
